# Bluetooth — NimBLE only (lighter than Bluedroid, no C++ exceptions needed)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_MODE_BLE_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=n

# Run FreeRTOS tick at 1 kHz for 1ms timer resolution
CONFIG_FREERTOS_HZ=1000

# 240 MHz for tight IMU sampling loop headroom
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Flash: 4MB default ESP32
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Logging: info level in release, reduce binary size
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
